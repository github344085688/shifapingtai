{
  "name": "web-ai-view",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "build-only": "vite build --mode production",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "build:clean": "rimraf dist && vite build --mode production"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "juejin-puts": "^1.0.2",
    "juejin-state": "^2.0.45",
    "mammoth": "^1.9.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "weixin-js-sdk": "^1.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^9.8.8",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.35",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "3.5.3",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  }
}